{
    "name": "api",
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--no-deprecation\" API_PORT=9090 tsx watch --env-file .env src/index.ts",
        "build": "tsdown",
        "start": "cross-env NODE_ENV=production PORT=9091 node dist/index.js",
        "start:dev": "cross-env NODE_ENV=development API_PORT=9090 node dist/index.js",
        "test": "vitest run"
    },
    "dependencies": {
        "@gemini-proxy/core": "workspace:*",
        "@hono/node-server": "^1.18.2",
        "hono": "^4.9.2"
    },
    "devDependencies": {
        "@types/node": "^20.11.17",
        "cross-env": "^7.0.3",
        "tsdown": "^0.17.0",
        "tsx": "^4.7.1",
        "typescript": "^5.9.2",
        "vitest": "~3.2.0"
    }
}
