# Supabase CLI — used by `pnpm db:apply` (remote) and optional `pnpm db:start` (local Docker).
#
# Remote apply (recommended for OSS clones — no Docker required):
#   1. Create a Supabase cloud project.
#   2. Copy the Session pooler URI from Dashboard → Connect.
#   3. Set SUPABASE_DB_URL below, then from repo root: pnpm db:apply
#
# Fallback (project ref + database password):
# SUPABASE_PROJECT_ID=your_project_id
# SUPABASE_DB_PASSWORD=your_database_password
#
# Optional: generate TypeScript types from remote schema
# SUPABASE_ACCESS_TOKEN=your_supabase_access_token

SUPABASE_PROJECT_ID=your_project_id
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Fallback when SUPABASE_DB_URL is not set:
# SUPABASE_DB_PASSWORD=your_database_password
