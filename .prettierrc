{
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxSingleQuote": false,
    "printWidth": 100,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.md", "*.mdx"],
            "options": {
                "parser": "markdown",
                "printWidth": 100,
                "proseWrap": "preserve",
                "tabWidth": 2,
                "useTabs": false,
                "singleQuote": false,
                "embeddedLanguageFormatting": "auto"
            }
        },
        {
            "files": ["*.json", "*.jsonc"],
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
