{
    "name": "gemini-proxy-monorepo",
    "version": "1.0.0",
    "description": "Monorepo for Gemini Proxy applications and packages",
    "private": true,
    "scripts": {
        "build": "pnpm --filter web run cf:build",
        "build:monorepo": "turbo run build",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=web",
        "dev:api": "turbo run dev --filter=api",
        "start": "turbo run start",
        "start:web": "turbo run start --filter=web",
        "start:api": "turbo run start --filter=api",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "clean": "turbo run clean",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "format:md": "prettier --write \"**/*.{md,mdx}\"",
        "format:md:check": "prettier --check \"**/*.{md,mdx}\"",
        "db:apply": "pnpm --filter @lehuygiang28/gemini-proxy-db db:apply",
        "db:push": "pnpm db:apply",
        "db:start": "supabase start",
        "db:reset": "supabase db reset",
        "db:stop": "supabase stop",
        "deploy": "pnpm --filter web run cf:deploy:only",
        "build:cloudflare": "pnpm --filter web run cf:build",
        "deploy:cloudflare": "pnpm --filter web run cf:deploy",
        "preview:cloudflare": "pnpm --filter web run cf:preview",
        "build:cloudflare:api": "pnpm --filter @lehuygiang28/gemini-proxy-cloudflare run build",
        "deploy:cloudflare:api": "pnpm --filter @lehuygiang28/gemini-proxy-cloudflare run deploy"
    },
    "devDependencies": {
        "@ai-sdk/google": "^2.0.6",
        "@google/genai": "^1.15.0",
        "@turbo/gen": "^1.12.4",
        "ai": "^5.0.15",
        "openai": "^5.12.2",
        "prettier": "^3.2.5",
        "supabase": "2.39.2",
        "tsdown": "^0.17.0",
        "turbo": "^2.5.8",
        "typescript": "^5.9.2"
    },
    "packageManager": "pnpm@10.18.1",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.15.0"
    },
    "cloudflare": {
        "bindings": {
            "NEXT_PUBLIC_SUPABASE_URL": {
                "description": "Supabase project URL from Dashboard → Settings → API. See [getting-started](docs/getting-started.md)."
            },
            "NEXT_PUBLIC_ANON_SUPABASE_KEY": {
                "description": "Supabase **anon** / publishable key (`sb_publishable_...`) for the dashboard client."
            },
            "SUPABASE_URL": {
                "description": "Same value as `NEXT_PUBLIC_SUPABASE_URL` (used by `/api/gproxy` on the server)."
            },
            "SUPABASE_SERVICE_ROLE_KEY": {
                "description": "Supabase **service role** secret (`sb_secret_...`). Keep private — never expose to the browser."
            }
        }
    }
}
