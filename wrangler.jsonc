/**
 * Default Cloudflare Worker: full-stack Next.js (OpenNext) — dashboard + /api/gproxy.
 * API-only deploy uses packages/cloudflare/wrangler.jsonc instead.
 * https://opennext.js.org/cloudflare/get-started
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "gemini-proxy-web",
    "main": "apps/web/.open-next/worker.js",
    "compatibility_date": "2026-08-20",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": "apps/web/.open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "gemini-proxy-web",
        },
    ],
}
