/**
 * Default Cloudflare Worker: full-stack Next.js (OpenNext) — dashboard + /api/gproxy.
 * API-only deploy uses packages/cloudflare/wrangler.jsonc instead.
 * https://opennext.js.org/cloudflare/get-started
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "gemini-proxy-web",
    "main": "apps/web/.open-next/worker.js",
    "compatibility_date": "2026-08-20",
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    /**
     * Deploy button / Workers Builds: NEXT_PUBLIC_* must be available at OpenNext build time.
     * Values from the deploy form are written here (and as Worker vars) when using Deploy to Cloudflare.
     * Local: use repo-root `.dev.vars` instead — do not commit real keys.
     */
    "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_ANON_SUPABASE_KEY": "",
    },
    "observability": {
        "enabled": true,
    },
    "assets": {
        "directory": "apps/web/.open-next/assets",
        "binding": "ASSETS",
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "gemini-proxy-web",
        },
    ],
}
